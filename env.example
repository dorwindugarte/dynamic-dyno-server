# Copia este archivo como ".env" (local) o crea estas mismas variables en tu hosting
# (Render, Railway, Fly.io, etc.) desde su panel de "Environment Variables".
# NUNCA subas el archivo ".env" real a GitHub ni lo compartas por chat.

# API Key de NOWPayments: Dashboard -> Settings -> API Keys (secreta)
NOWPAYMENTS_API_KEY=

# IPN Secret Key de NOWPayments: Dashboard -> Settings -> IPN callback (secreta)
NOWPAYMENTS_IPN_SECRET=

# URL pública de ESTE servidor una vez desplegado (te la da tu hosting)
PUBLIC_URL=

# URL pública de tu página (dynamic-dyno.html) publicada
FRONTEND_URL=

# Precio de $DYNO en USD, debe coincidir con CONFIG.price del HTML
DYNO_PRICE=0.02

MIN_USD=10
MAX_USD=5000
PORT=3000
